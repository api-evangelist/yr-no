  "info": {
    "_postman_id": "6b9222bf-70f7-444b-a630-b1bb544d7e2e",
    "name": "Locationforecast alerts metadata API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Weather forecasts for any location on Earth up to nine days ahead, returning temperature, wind, precipitation, cloud cover, humidity, and more. Available in compact JSON, complete JSON with probabilistic percentiles, and legacy XML formats. Data is open under CC BY 4.0 and requires only a User-Agent header.\n\nContact Support:\n Name: Developer Support\n Email: weatherapi-adm@met.no",
      "type": "text/plain"
    }
  }
